# Ignore compiled binaries and object files
*.exe
*.out
*.o
*.obj
*.dll
*.so

# Ignore build directories and common output folders
/build/
/bin/
/obj/

# Ignore Visual Studio / VS Code / JetBrains IDE folders
/.vscode/
/.vs/
/.idea/

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore logs and databases
*.log
*.sqlite
*.db

# Ignore Python cache (if any helper scripts exist)
__pycache__/
*.py[cod]

# Misc
*.user
*.suo
*.ncb
*.sdf
*.VC.db
